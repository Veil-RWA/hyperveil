# HyperVeil frontend. Same shape as veilx/app/.env and bridge/frontend/.env,
# and it WINS over public/deployment.json: the deployment file carries the
# contract addresses, this carries the endpoints a developer wants to change
# without regenerating it.
#
# Vite only exposes VITE_* to the browser, and only reads this at startup —
# restart `npm run dev` after editing.

# The public RPC the app reads Starknet through. The free endpoints drop calls
# under load, which shows up as "RPC: starknet_call with params …" in the app.
VITE_STARKNET_RPC_URL=https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/<your key>

# The SNIP-36 prover, and the account it submits settles from. Without the
# master address every proven action fails with "no master account configured".
VITE_VEIL_PROVER_ENDPOINT=https://<your-prover-host>
VITE_VEIL_MASTER_ACCOUNT_ADDRESS=0x<the account your prover submits from>

# The keeper's intake: where orders, cancels and the testnet allowlist go.
VITE_KEEPER_INTAKE=https://<your-keeper-intake>
