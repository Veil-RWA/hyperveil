# ─────────────────────────────────────────────────────────────────────────────
# HyperVeil — the DEPLOY SCRIPTS' environment.
#
#   cp .env.example .env
#   set -a && . ./.env && set +a
#
# This file holds PRIVATE KEYS. It is gitignored; keep it that way, and use
# throwaway testnet accounts. The app and the keeper have their own
# configuration, written by write-config.js.
#
#   deploy-hyperevm.js    EVM_PRIVATE_KEY
#   deploy-starknet.js    SN_ACCOUNT_ADDRESS, SN_PRIVATE_KEY
#   wire.js               all of them (it touches both chains)
#   configure-dvns.js     all of them
#   whitelist.js          SN_ACCOUNT_ADDRESS, SN_PRIVATE_KEY
# ─────────────────────────────────────────────────────────────────────────────

# ── HyperEVM ─────────────────────────────────────────────────────────────────
# The account that deploys the omnibus and owns it. It needs HYPE for gas and
# a HyperCore account (the big-block flag lives on the HyperCore user).
# Testnet HYPE: buy it on the testnet spot market with faucet USDC, then send
# it to 0x2222222222222222222222222222222222222222 to move it to HyperEVM.
EVM_PRIVATE_KEY=0x<64 hex chars>
# Optional: the scripts default to the RPC pinned in config.js.
# EVM_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm

# ── Starknet ─────────────────────────────────────────────────────────────────
# A DEPLOYED account contract and its key (Starknet has no EOAs), funded with
# STRK. It owns the pool, the gateway, the twins and the KYC list.
SN_ACCOUNT_ADDRESS=0x<account contract address>
SN_PRIVATE_KEY=0x<key>
# Must serve RPC spec 0.8+: starknet.js v10 cannot talk to an older node.
# SN_RPC_URL=https://starknet-sepolia.drpc.org
# What the APP should use (defaults to SN_RPC_URL / the pinned one).
# SN_PUBLIC_RPC_URL=https://starknet-sepolia.drpc.org

# ── Services ─────────────────────────────────────────────────────────────────
# The SNIP-36 prover the app and the keeper prove against, and the keeper's
# intake URL the app posts order openings to. Both go into the written config.
# PROVER_ENDPOINT=https://<prover>
# HV_INTAKE_URL=http://localhost:8787

# ── StarkWare's STRK20 pool ──────────────────────────────────────────────────
# Optional. With it, deploy-starknet.js also deploys the STRK20 -> Veil entry,
# and the app offers "from STRK20" as a way to fund a Veil balance.
# Starknet Sepolia (verified on-chain 2026-09-19):
# STRK20_POOL=0x0254a6b2997ef52e9f830ce1f543f6b29768295e8d17e2267d672c552cfe0d91
